{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "plan": {
      "permission": {
        "todoread": "allow",
        "todowrite": "allow",
      },
    },
  },
  "default_agent": "plan",
  "model": "opencode/deepseek-v4-flash-free",
  "permission": {
    "bash": "ask",
    "webfetch": "ask",
    "websearch": "ask",
  },
}
