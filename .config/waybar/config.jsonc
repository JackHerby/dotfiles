[
  {
    "output": ["DP-1"],
    "height": 40,
    "spacing": 4,
    "modules-left": ["hyprland/workspaces", "hyprland/submap"],
    "modules-center": ["hyprland/window"],
    "modules-right": [
      "mpris",
      "idle_inhibitor",
      "load",
      "wireplumber",
      "clock",
      "tray",
      "custom/power",
    ],
    "hyprland/workspaces": {
      "warp-on-scroll": false,
      "enable-bar-scroll": true,
      "disable-scroll-wraparound": true,
    },
    "hyprland/window": {
      "format": "{title}",
      "max-length": 40,
      "all-outputs": true,
    },
    "mpris": {
      "format": " {status_icon} {dynamic}",
      "interval": 1,
      "dynamic-len": 40,
      "status-icons": {
        "playing": "▶",
        "paused": "⏸",
        "stopped": "",
      },
      "dynamic-order": ["title", "artist"],
      "ignored-players": ["firefox"],
    },
    "idle_inhibitor": {
      "format": "{icon} ",
      "format-icons": {
        "activated": "",
        "deactivated": "",
      },
    },
    "hyprland/submap": {
      "format": "{}",
    },
    "tray": {
      "icon-size": 14,
      "spacing": 10,
    },
    "load": {
      "format": " {}",
    },
    "clock": {
      "tooltip-format": "<big>{:%y %b}</big>\n<tt><small>{calendar}</small></tt>",
      "format-alt": "{:%y-%m-%d}",
    },
    "wireplumber": {
      "scroll-step": 5,
      "format": "{icon} {volume}%",
      "format-bluetooth": "{icon} {volume}% ",
      "format-bluetooth-muted": " {icon}",
      "format-muted": "",
      "format-icons": {
        "headphone": "",
        "hands-free": "",
        "headset": "",
        "phone": "",
        "portable": "",
        "car": "",
        "default": ["", "", ""],
      },
      "on-click": "wpctl set-mute @default_audio_sink@ toggle",
    },
    "custom/power": {
      "format": "power ⏻",
      "tooltip": false,
      "on-click": "wlogout",
    },
  },
  {
    "output": ["DP-2"],
    "height": 40,
    "spacing": 4,
    "modules-left": ["hyprland/workspaces", "hyprland/submap"],
    "modules-center": ["hyprland/window"],
    "modules-right": [
      "idle_inhibitor",
      "load",
      "wireplumber",
      "clock",
      "tray",
      "custom/power",
    ],
    "hyprland/workspaces": {
      "warp-on-scroll": false,
      "enable-bar-scroll": true,
      "disable-scroll-wraparound": true,
    },
    "hyprland/window": {
      "format": "{title}",
      "max-length": 40,
      "all-outputs": true,
    },
    "idle_inhibitor": {
      "format": "{icon} ",
      "format-icons": {
        "activated": "",
        "deactivated": "",
      },
    },
    "hyprland/submap": {
      "format": "{}",
    },
    "tray": {
      "icon-size": 14,
      "spacing": 10,
    },
    "load": {
      "format": " {}",
    },
    "clock": {
      "tooltip-format": "<big>{:%y %b}</big>\n<tt><small>{calendar}</small></tt>",
      "format-alt": "{:%y-%m-%d}",
    },
    "wireplumber": {
      "scroll-step": 5,
      "format": "{icon} {volume}%",
      "format-bluetooth": "{icon} {volume}% ",
      "format-bluetooth-muted": " {icon}",
      "format-muted": "",
      "format-icons": {
        "headphone": "",
        "hands-free": "",
        "headset": "",
        "phone": "",
        "portable": "",
        "car": "",
        "default": ["", "", ""],
      },
      "on-click": "wpctl set-mute @default_audio_sink@ toggle",
    },
    "custom/power": {
      "format": "power ⏻",
      "tooltip": false,
      "on-click": "wlogout",
    },
  },
  {
    "output": ["HDMI-A-1"],
    "height": 40,
    "spacing": 4,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["hyprland/window"],
    "hyprland/workspaces": {
      "warp-on-scroll": true,
      "enable-bar-scroll": true,
    },
    "hyprland/window": {
      "format": "{title}",
      "max-length": 40,
      "all-outputs": true,
    },
    "clock": {
      "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
      "format-alt": "{:%Y-%m-%d}",
    },
  },
]
